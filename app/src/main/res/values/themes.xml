<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.InstaEclipse" parent="Theme.Material3Expressive.Dark.NoActionBar">
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/accent_blue</item>
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorSecondary">#25FFFFFF</item>
        <item name="colorSecondaryContainer">#25FFFFFF</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>
        <item name="colorSurfaceContainer">#141418</item>
        <item name="android:windowBackground">@color/black</item>
    </style>

    <style name="Widget.InstaEclipse.BottomNavText.Active" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">10.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="Widget.InstaEclipse.BottomNavText.Inactive" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">10.5sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">#8E8E93</item>
    </style>
</resources>
