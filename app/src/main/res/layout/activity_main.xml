<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#070709">

<com.google.android.material.appbar.AppBarLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#BF09090B" android:elevation="0dp">
<com.google.android.material.appbar.MaterialToolbar android:id="@+id/top_app_bar" android:layout_width="match_parent" android:layout_height="64dp" android:paddingStart="16dp" android:paddingEnd="8dp" android:background="@android:color/transparent">
<LinearLayout android:id="@+id/header_identity" android:layout_width="0dp" android:layout_height="match_parent" android:layout_gravity="start" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
<FrameLayout android:layout_width="32dp" android:layout_height="32dp">
<ImageView android:id="@+id/toolbar_title_image" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_feature_hub_icon" android:padding="8dp" android:src="@drawable/ic_sparkle" android:contentDescription="App Logo" app:tint="#F4F4F6"/>
<View android:layout_width="9dp" android:layout_height="9dp" android:layout_gravity="bottom|end" android:layout_marginEnd="-1dp" android:layout_marginBottom="-1dp" android:background="@drawable/bg_status_dot"/>
</FrameLayout>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
<TextView android:id="@+id/toolbar_title_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="#F4F4F6" android:textSize="17sp" android:textStyle="bold" android:letterSpacing="-0.02"/>
<TextView android:id="@+id/toolbar_version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:background="@drawable/bg_web_soft_pill" android:paddingStart="8dp" android:paddingTop="2dp" android:paddingEnd="8dp" android:paddingBottom="2dp" android:text="@string/version" android:textColor="#F0F0F2" android:textSize="9sp" android:textStyle="bold"/>
</LinearLayout>
<TextView android:id="@+id/toolbar_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="LSPosed Active" android:textColor="#92929A" android:textSize="10sp"/>
</LinearLayout>
</LinearLayout>
<LinearLayout android:id="@+id/header_actions" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="end" android:gravity="center_vertical">
<ImageButton android:id="@+id/header_update_btn" android:layout_width="38dp" android:layout_height="38dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="9dp" android:src="@drawable/ic_update_web" android:visibility="gone" android:contentDescription="Update available" app:tint="#F4F4F6"/>
<ImageButton android:id="@+id/header_download_apk_btn" android:layout_width="38dp" android:layout_height="38dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="9dp" android:src="@drawable/ic_download" android:contentDescription="Download and install APK" app:tint="#A5A5AD"/>
<ImageButton android:id="@+id/header_restart_btn" android:layout_width="38dp" android:layout_height="38dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="9dp" android:src="@drawable/ic_refresh_web" android:contentDescription="Restart Instagram" app:tint="#A5A5AD"/>
<ImageButton android:id="@+id/header_about_btn" android:layout_width="38dp" android:layout_height="38dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="9dp" android:src="@drawable/ic_info" android:contentDescription="About" app:tint="#A5A5AD"/>
</LinearLayout>
</com.google.android.material.appbar.MaterialToolbar>
</com.google.android.material.appbar.AppBarLayout>

<FrameLayout android:id="@+id/fragment_container" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="104dp" app:layout_behavior="@string/appbar_scrolling_view_behavior"/>

<LinearLayout android:id="@+id/floating_navpill" android:layout_width="match_parent" android:layout_height="64dp" android:layout_gravity="bottom" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="20dp" android:background="@drawable/bg_navigation_dock" android:elevation="18dp" android:gravity="center" android:orientation="horizontal" android:padding="6dp">
<TextView android:id="@+id/nav_home" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_nav_item" android:gravity="center" android:text="⌂\nHome" android:textColor="#F4F4F6" android:textSize="10sp" android:textStyle="bold"/>
<TextView android:id="@+id/nav_features" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_nav_item_inactive" android:gravity="center" android:text="☷\nFeatures" android:textColor="#92929A" android:textSize="10sp"/>
<TextView android:id="@+id/nav_logs" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_nav_item_inactive" android:gravity="center" android:text="⌘\nLogs" android:textColor="#92929A" android:textSize="10sp"/>
<TextView android:id="@+id/nav_help" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_nav_item_inactive" android:gravity="center" android:text="?\nHelp" android:textColor="#92929A" android:textSize="10sp"/>
</LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>