<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070709"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="32dp">

        <!-- Web Header / release announcement -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/release_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#17171C"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="#38383F"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_web_badge"
                        android:paddingStart="9dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="4dp"
                        android:text="V2.0 RELEASED"
                        android:textColor="#08080A"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="InstaEclipse v2.0"
                        android:textColor="#F4F4F6"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_web_soft_pill"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="Stable"
                        android:textColor="#C7C7CD"
                        android:textSize="10sp" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="All feature branches &amp; patches have been consolidated into main: Ghost Mode v2, Media Downloader, DexKit resolvers, and GPS spoofing."
                    android:textColor="#B5B5BD"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/banner_download_v2_apk_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="Download &amp; Install APK"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:backgroundTint="#F4F4F6"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_download"
                        app:iconTint="#08080A" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/banner_telegram_btn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:text="Telegram"
                        android:textSize="11sp"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_send"
                        app:iconTint="#F4F4F6" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Target Instagram status -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/instagram_status_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#121216"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="#303037"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/instagram_logo"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_feature_hub_icon"
                        android:padding="12dp"
                        android:src="@drawable/ic_instagram_logo"
                        android:contentDescription="@string/instagram_logo"
                        app:tint="#F4F4F6" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="13dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/instagram_status_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/checking_instagram"
                                android:textColor="#F4F4F6"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                            <ImageView
                                android:id="@+id/instagram_info_icon"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:padding="9dp"
                                android:src="@drawable/ic_info"
                                android:contentDescription="@string/instagram_info"
                                app:tint="#92929A" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/instagram_variant_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="#8F8F97"
                            android:textSize="11sp"
                            android:visibility="gone" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/instagram_multi_button"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="-10dp"
                            android:text="@string/multiple_versions_detected"
                            android:textSize="10sp"
                            android:visibility="gone"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/launch_instagram_button"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="@string/launch_instagram"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:backgroundTint="#F4F4F6"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_play"
                        app:iconTint="#08080A" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/download_instagram_button"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Download APK"
                        android:textSize="11sp"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_download"
                        app:iconTint="#F4F4F6" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:paddingTop="11dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_web_divider_top">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Target variant"
                        android:textColor="#8E8E96"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/target_variant_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Detected Instagram"
                        android:textColor="#D9D9DE"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Feature Hub -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/feature_hub_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#121216"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="#303037"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:padding="16dp">
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_feature_hub_icon"
                    android:padding="11dp"
                    android:src="@drawable/ic_sparkle"
                    android:contentDescription="Feature Hub"
                    app:tint="#F4F4F6" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="13dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Feature Hub"
                        android:textColor="#F4F4F6"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Install feature packs and manage the catalog."
                        android:textColor="#92929A"
                        android:textSize="11sp" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#707078"
                    android:textSize="28sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- How to use -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/how_to_use_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#121216"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="#303037"
            app:strokeWidth="1dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="17dp">
                <TextView
                    android:id="@+id/how_to_use_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/how_to_use"
                    android:textColor="#F4F4F6"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <ImageView
                    android:id="@+id/search_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_search"
                    app:tint="#92929A" />
                <TextView
                    android:id="@+id/instruction_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/how_to_use_title"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="40dp"
                    android:text="@string/usage_instructions"
                    android:textColor="#92929A"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Leadership -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/leadership_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#121216"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="#303037"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="17dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_crown"
                        app:tint="#F4F4F6" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="PROJECT LEADERSHIP &amp; CONTINUATION"
                        android:textColor="#F4F4F6"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/full_credits_link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Full Credits ›"
                        android:textColor="#A4A4AC"
                        android:textSize="10sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="#24242A" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_web_avatar"
                        android:gravity="center"
                        android:text="ZH"
                        android:textColor="#F4F4F6"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Zehen" android:textColor="#F4F4F6" android:textSize="13sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:background="@drawable/bg_web_badge" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="Lead" android:textColor="#08080A" android:textSize="9sp" android:textStyle="bold" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Active Project Continuation Lead" android:textColor="#BEBEC5" android:textSize="11sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Maintaining the project, integrating stable patches, and driving the current release line." android:textColor="#85858D" android:textSize="10sp" android:lineSpacingExtra="2dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Telegram: @Zehen0i" android:textColor="#888890" android:textSize="10sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/contact_zehen_btn" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Contact Zehen" android:textSize="10sp" app:cornerRadius="12dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical">
                    <TextView android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bg_web_small_avatar" android:gravity="center" android:text="SK" android:textColor="#F4F4F6" android:textSize="10sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Somil Khan" android:textColor="#E7E7EB" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Original Founder" android:textColor="#85858D" android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Contributors -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#121216"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="#303037"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="17dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="CONTRIBUTORS" android:textColor="#F4F4F6" android:textSize="11sp" android:textStyle="bold" />
                <HorizontalScrollView android:id="@+id/contributors_scroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                    <LinearLayout android:id="@+id/contributors_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#121216"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="#303037"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="17dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="SPECIAL THANKS" android:textColor="#F4F4F6" android:textSize="11sp" android:textStyle="bold" />
                <HorizontalScrollView android:id="@+id/special_thanks_scroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                    <LinearLayout android:id="@+id/special_thanks_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>