      "version": "1.0.0",
      "delivery": "builtin",
      "release_url": "https://github.com/somilkhan/InstaEclipse/releases/latest",
      "pref_keys": ["enablePostDownload", "enableStoryDownload", "enableReelDownload", "enableProfileDownload"]
    },
    {
      "id": "clean-feed-pack",
      "name": "Clean Feed Pack",
      "description": "Remove suggested feed and Threads suggestion units.",
      "version": "1.0.0",
      "delivery": "builtin",
      "release_url": "https://github.com/somilkhan/InstaEclipse/releases/latest",
      "pref_keys": ["hideSuggestionsInFeed", "hideThreadsSuggestions"]
    },
    {
      "id": "theme-pack",
      "name": "Theme Pack",
      "description": "Enable InstaEclipse custom Instagram theming and palette controls.",
      "version": "1.0.0",
      "delivery": "builtin",
      "release_url": "https://github.com/somilkhan/InstaEclipse/releases/latest",
      "pref_keys": ["customThemeEnabled"]
    },
    {
      "id": "pfp-downloader",
